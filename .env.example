# ============================================================================
# Archival Turkish OCR & Searchable PDF/A-2b API Service Configuration
# ============================================================================

APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LOG_JSON=true

# Security & Authentication (FR-17)
AUTH_ENABLED=false
API_KEYS=
MAX_UPLOAD_MB=500
MAX_IMAGE_PIXELS=175000000
MAX_PAGES_PER_JOB=1000

# OCR Engine & CPU Thread Governance (FR-04, FR-13, FR-15)
# On a 16-core AMD EPYC server with 64 GB RAM:
# Recommended: OCR_WORKER_COUNT=10, OCR_THREADS_PER_WORKER=1 (leaves 6 cores for OS, API, PDF/A I/O)
OCR_LANGUAGE=tur
OCR_WORKER_COUNT=10
OCR_THREADS_PER_WORKER=1
OCR_WORKING_DPI=300
DEFAULT_ASSUMED_DPI=300
OCR_FORCE=false

# Job Queue, Timeouts & Retries (FR-02, FR-10)
JOB_MAX_RETRIES=2
JOB_TIMEOUT_SECONDS=1800
PAGE_TIMEOUT_SECONDS=180
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=15
WORKER_POLL_INTERVAL_SECONDS=0.5
MAX_CONCURRENT_JOBS=10
MAX_QUEUE_DEPTH=500

# Job Types & Worker Pools
# Each worker process only claims the listed job types (ocr, package).
# MAX_CONCURRENT_JOBS caps OCR; packaging has its own cap.
WORKER_JOB_TYPES=ocr
MAX_CONCURRENT_PACKAGE_JOBS=1
PACKAGE_RETENTION_HOURS=168
PACKAGE_JOB_TIMEOUT_SECONDS=21600
MAX_PACKAGE_ENTRIES=100000
MAX_PACKAGE_FILE_MB=2048
MAX_PACKAGE_PART_MB=4096

# Internal CDN inputs (POST /api/v1/jobs/from-cdn) — worker downloads files itself
CDN_BASE_URL=
CDN_VERIFICATION_ID=
CDN_TIMEOUT_SECONDS=180
CDN_VERIFY_TLS=true

# Signed completion callbacks (empty prefix list = callbacks disabled)
CALLBACK_HMAC_SECRET=
CALLBACK_ALLOWED_PREFIXES=
CALLBACK_TIMEOUT_SECONDS=15
CALLBACK_MAX_ATTEMPTS=12
CALLBACK_VERIFY_TLS=true

# Temporary Storage & Retention (FR-09)
TEMP_STORAGE_PATH=/data/ocr
RESULT_RETENTION_HOURS=24
FAILED_RETENTION_HOURS=12
METADATA_RETENTION_DAYS=30
MAX_DISK_USAGE_GB=50.0
MIN_FREE_DISK_MB=512
CLEANUP_INTERVAL_SECONDS=60.0

# PDF/A & Source Visual Preservation (FR-05, FR-13, FR-14)
PDF_A_PROFILE=PDF/A-2b
PRESERVE_SOURCE_IMAGES=true
DESKEW_WORKING_IMAGE=true
REQUIRE_VERAPDF=false
